# Шаблон переменных Docker-раскатки. Скопируйте в .env и заполните:
#   cp .env.example .env
# .env — секреты, файл исключён из git (.gitignore).

# Пароль root MySQL; ДОЛЖЕН совпадать с db.password в config.docker.yaml
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Имя базы данных; ДОЛЖЕН совпадать с db.database в config.docker.yaml
MYSQL_DATABASE=tgexport

# Часовой пояс контейнера (логи и cron)
TZ=Europe/Moscow

# Ниже — необязательные переключатели (по умолчанию включены оба режима;
# задавать здесь можно, но в docker-compose.yml они уже прописаны с дефолтами)
# RUN_EXPORT=1
# RUN_DB=1
# CRON_SCHEDULE=*/3 * * * *
